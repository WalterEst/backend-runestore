# =====================================================================
# Variables de entorno — Backend RUNE (NestJS)
# Copiar a .env y completar. .env NUNCA se commitea (ver .gitignore).
# =====================================================================

# Entorno
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Frontend permitido por CORS (credentials: true, jamás '*')
FRONTEND_ORIGIN=http://localhost:4200
# URL pública del backend: Transbank redirige el navegador del cliente aquí tras pagar
BACKEND_PUBLIC_URL=http://localhost:3000/api/v1

# MySQL — el usuario de la app solo tiene SELECT/INSERT/UPDATE/DELETE (sin DROP/GRANT/SUPER)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tienda_anime
DB_USER=tienda_anime_app
DB_PASSWORD=cambiar_esta_password
# Credenciales root solo para inicializar el contenedor de MySQL en desarrollo
DB_ROOT_PASSWORD=cambiar_esta_password_root

# JWT — generar con: openssl rand -hex 64. DEBEN ser distintos entre sí.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cifrado del secreto TOTP (2FA) en BD — generar con: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# Seed del primer admin (solo se usa una vez, vía `npm run seed:admin`)
SEED_ADMIN_EMAIL=admin@runewear.cl
SEED_ADMIN_PASSWORD=cambiar_esta_password_admin
SEED_ADMIN_NOMBRE=Admin
SEED_ADMIN_APELLIDO=RUNE

# --- Servicios externos (completar en fases posteriores) ---

# Cloudflare R2 (imágenes)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Cloudflare Turnstile (anti-bots)
TURNSTILE_SECRET_KEY=

# Webpay Plus (Transbank) — modo integración por defecto
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
TRANSBANK_ENVIRONMENT=integration

# Mercado Pago (opcional)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Emisor DTE (OpenFactura / LibreDTE)
DTE_PROVIDER=
DTE_API_KEY=
DTE_ENVIRONMENT=certificacion
DTE_RUT_EMISOR=
DTE_RAZON_SOCIAL_EMISOR=

# Email transaccional (SES o Brevo)
EMAIL_PROVIDER=brevo
EMAIL_API_KEY=
EMAIL_FROM=no-responder@runewear.cl

# Sentry
SENTRY_DSN=
